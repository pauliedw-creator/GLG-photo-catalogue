---
import Base from '../layouts/Base.astro';
import { t } from '../i18n.js';

const lang = 'pl';
const i18n = t(lang);

const PHONE = '+48782501122';
const PHONE_DISPLAY = '+48 782-50-11-22';
const EMAIL = 'golden.leaf.granites@outlook.com';
const ADDRESS = 'Nowa Dębowa Wola, Świętokrzyskie';
const WEB3FORMS_KEY = 'dba5f8a3-5109-421f-9e98-04be168224cb';
---
<Base title={i18n.contact.title} lang={lang} canonicalPath="/kontakt">
  <div class="container">
    <div class="page-title-block">
      <h1>{i18n.contact.title}</h1>
      <p class="lede">{i18n.contact.lead}</p>
    </div>

    <div class="contact-grid">
      <div class="contact-info">
        <dl>
          <div>
            <dt>{i18n.contact.phone}</dt>
            <dd><a href={`tel:${PHONE}`}>{PHONE_DISPLAY}</a></dd>
          </div>
          <div>
            <dt>{i18n.contact.email}</dt>
            <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
          </div>
          <div>
            <dt>{i18n.contact.address}</dt>
            <dd>{ADDRESS}</dd>
          </div>
          <div>
            <dt>{i18n.contact.hours}</dt>
            <dd>{i18n.contact.hoursValue}</dd>
          </div>
        </dl>
      </div>

      <div class="contact-form">
        <h3 style="margin-bottom: 1rem;">{i18n.contact.formTitle}</h3>
        <form id="enquiry-form">
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="Nowe zapytanie z katalogu GLG" />
          <input type="hidden" name="from_name" value="Katalog GLG" />
          <input type="text" name="website" class="form-honeypot" tabindex="-1" autocomplete="off" />

          <div class="form-row">
            <label for="company">{i18n.contact.form.company} <span style="color: var(--gold)">*</span></label>
            <input type="text" id="company" name="company" required />
          </div>
          <div class="form-row">
            <label for="name">{i18n.contact.form.name} <span style="color: var(--gold)">*</span></label>
            <input type="text" id="name" name="name" required />
          </div>
          <div class="form-row">
            <label for="phone">{i18n.contact.form.phone} <span style="color: var(--gold)">*</span></label>
            <input type="tel" id="phone" name="phone" required />
          </div>
          <div class="form-row">
            <label for="email">{i18n.contact.form.email}</label>
            <input type="email" id="email" name="email" />
          </div>
          <div class="form-row">
            <label for="slabIds">{i18n.contact.form.slabIds}</label>
            <input type="text" id="slabIds" name="slabIds" placeholder="GLG-251105-01, GLG-251105-02..." />
          </div>
          <div class="form-row">
            <label for="message">{i18n.contact.form.message}</label>
            <textarea id="message" name="message"></textarea>
          </div>

          <button type="submit" class="btn btn--primary btn--full" style="margin-top: 1rem;">
            {i18n.contact.form.submit}
          </button>
          <div class="form-status" id="form-status" role="status"></div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    const slab = params.get('slab');
    if (slab) document.getElementById('slabIds').value = slab;

    const form = document.getElementById('enquiry-form');
    const status = document.getElementById('form-status');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.website.value) return;

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form)
        });
        const result = await res.json();
        if (result.success) {
          status.className = 'form-status success';
          status.textContent = 'Dziękujemy. Skontaktujemy się wkrótce.';
          form.reset();
        } else {
          throw new Error(result.message || 'submit failed');
        }
      } catch (err) {
        status.className = 'form-status error';
        status.textContent = 'Wystąpił błąd. Prosimy zadzwonić bezpośrednio: +48 782-50-11-22';
      }
    });
  </script>
</Base>

